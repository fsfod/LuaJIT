//
// The built-in numeric types are uint8/s8, uint16/s16, uint32/s32, uint64/s64 unsigned and signed respectively.
// Field types that are declared with just a number  are considered unsigned bit fields with a max size of 32 bits.
// Array fields are specified as a element type inside brackets with the name of
// the array's length field in-between them like this int32[elementcount_field].
//
//Special field types
//  ptr: A pointer field that is always stored as a 64 bit value on both 32 bit and 64 bit builds.
//  GCRef: A pointer to a GC object passed in to the log function as a GCRef struct value. This type is
//         32 bits wide on both 32 bit and 64 bit (non GC64) builds it grows to 64 bits for GC64 builds.
//  GCRefPtr: The same as GCRef except the value is passed in as a pointer instead of a GCRef struct
//            in the writer.
//  bool: A boolean stored as a bit field with a bit width of one. It should be turned back into a native
//        boolean value by the reader.
//  timestamp: An implicit 64 bit time stamp generated when the message is written. By default this is
//             the value returned from rdtsc.
//  string: An array field that has extra logic in both the writer and reader side to work as a string.
//          If no length field is specified one is implicitly generated and strlen is used to determine
//          the length on the writer side and the null terminator skipped.
//  stringlist: A list of strings joined together into an array but separated with nulls chars.
//

message header {
  fileheader : 24
  version : uint32
  headersize : uint32
  flags : uint32
  vtables : [uint16]
  vtable_offsets : [uint32]
  msgsizes : [int32]
  typenames : stringlist
  cpumodel : string
  os : string
  ggaddress : uint64
  msgtype_count : uint8
  structtype_count : uint16
  tabletype_count : uint16
  starttime: timestamp
  timerfreq : uint64
  enums : [enumdef]
  vmsettings : VMSettings
  vmdef : VMDef
  gcinfo : gc_info
  reflect : ReflectInfo
}

message stringmarker{
  time : timestamp
  jitted : bool
  flags : 16
  label : string
  stack : luastack (optional)
}

message idmarker4b (no_vtable){
  jited : bool
  flags : 7
  id : 16
}

message idmarker (no_vtable, mapto : idmarker4b){
  time : timestamp
  jited : bool
  flags : 7
  id : 16
}

message note{
  time : timestamp
  isbinary : bool
  isinternal : bool
  label : string
  data : [uint8] (argtype : const void*)
}

table enumdef{
  isbitflags : bool
  name : string
  namecount : uint32
  valuenames : stringlist
}

message trace_exit (no_vtable){
  isgcexit : bool
  traceid : uint16
  exit : uint16
}

message trace_exitsmall (no_vtable, mapto : trace_exit) {
  isgcexit : bool
  traceid : 14
  exit : 9
}

message trace_exitfull (mapto : trace_exit) {
  time : timestamp
  isgcexit : bool
  traceid : uint16
  exit : uint16
  registers : register_state (optional)
}

table register_state{
  source : uint8
  gpr_count : uint8
  fpr_count : uint8
  vec_count : uint8
  gprs : [uint8]
  fprs : [uint8]
  vregs : [uint8]
}

message trace_flushall{
  time : timestamp
  reason : uint16 (enum : flushreason)
  tracelimit : uint16
  mcodelimit : uint32
}

table VMSettings{
  jitparams : [int32]
  jitparams_default: [int32]  (optional)
  gc_stepmul : uint32
  gc_pause : uint32
}

table VMDef{
  flushreason : stringlist
  jitparams : stringlist
  gcstates : stringlist
  gcatomic_stages : stringlist
  bc : stringlist
  bc_mode : [uint16]
  fastfuncs : stringlist
  terror: stringlist
  trace_errors : stringlist
  ir : stringlist
  ir_mode : [uint8]
  irtypes : stringlist
  ircalls : stringlist
  irfpmath : stringlist
  irfields : stringlist
  trace_link : stringlist
}

message gcstate {
  time : timestamp
  stepstart : uint64
  prevstate : uint8
  gcinfo : gc_info
}

table gc_info{
  totalmem : GCSize
  strnum : uint32
  state : uint8 (enum : gcstate)
  infullgc : bool
  steptime : uint64
  maxpause : uint64
}

message statechange (no_vtable) {
  time : timestamp
  system : 8
  state : 8
  flags : 8
}

message obj_label{
  objtype : 4
  obj : GCRefPtr
  label : string
  flags : 20
}

message obj_string{
  address : GCRef
  len : uint32
  hash : uint32
  data : [uint8] (buflen : len, argtype : const char *)

  structcopy = {
    fields = {
      "len",
      "hash",
	},
	arg = {
	  name = "s",
	  type = "GCstr *",
	},
    store_address = "address",
  }
}

message obj_proto{
  address : GCRef
  size : uint32
  chunkname : string
  firstline : int32
  numline : int32
  flags : uint32
  numparams : uint8
  framesize : uint8
  uv_count : uint8
  kgc_count : uint16
  knum_count : uint16
  bcaddr : MRef
  bclen : uint32
  bc : [uint32]
  knum : [double] (buflen : knum_count)
  kgc : [GCRef] (buflen : kgc_count)
  lineinfo : [uint8]
  varnames : stringlist (prepacked)
  varinfo : [VarRecord]
  uvnames : stringlist (prepacked)

  structcopy = {
    fields = {
      "firstline",
      "numline",
      bclen = "sizebc",
      kgc_count = "sizekgc",
      knum_count = "sizekn",
      size = "sizept",
      "numparams",
      "framesize",
      uv_count = "sizeuv",
      "flags",
	},
	arg = {
	  name = "pt",
	  type = "GCproto *",
	},
    store_address = "address",
  }
}

struct VarRecord{
  startpc : uint32
  extent: uint32
}

message protoloaded{
  time : timestamp
  address : GCRefPtr
}

message loadscript{
  time : timestamp
  isloadstart : bool
  isfile : bool
  caller_ffid : uint8
  name : string
  mode : string
}

message scriptsrc{
  sourcechunk : string (explicit_length)
}

message obj_func{
  address : GCRefPtr
  proto_or_cfunc : ptr
  ffid : uint8
  upvalues : [uint64] (argtype : TValue *)
}

message trace_start{
  time : timestamp
  stitched : bool
  id : uint16
  parentid : uint16
  parentexit : uint16
  rootid : uint16
  startpt : GCRefPtr (argtype : GCproto*)
  startpc : uint32 (argtype : BCPos)
  callstack : luastack (optional)
}

message trace{
  time : timestamp
  aborted : bool
  stitched : bool
  id : uint16
  parentid : uint16 (argtype : TraceNo1)
  parentexit : uint16
  linktype : uint8 (enum : trace_link)
  startpt : GCRef
  stoppt : GCRefPtr
  stoppc : uint32 (argtype : BCPos)
  stopfunc : GCRefPtr
  abortcode : uint16
  abortinfo : uint16
  ins_count : uint16
  constant_count : uint16
  root : uint16
  nsnap: uint16
  nsnapmap: uint16
  spadjust : uint16
  link : uint16
  startpc : uint32 (argtype : BCPos)
  mcodesize : uint32
  mcodeaddr : ptr
  mcode : [uint8]
  ir : [uint64] (argtype : IRIns *)
  snapshots : [TraceSnapshot]
  snapmap : [uint32] (buflen : nsnapmap)
  tracedfuncs : [TracedFunc]
  tracedbc : [TracedBC]
  structcopy = {
    fields = {
      id = "traceno",
      "startpt",
      "linktype",
      "root",
      "nsnap",
      "nsnapmap",
      "spadjust",
      "link",
      mcodeaddr = "mcode",
      mcodesize = "szmcode",
      "snapmap",
	},
    arg = {
	  name = "trace",
	  type = "GCtrace *",
	}
  }
}

struct TraceSnapshot{
  mapofs : uint32;	// Offset into snapshot map. 
  mcode_offset : uint32
  first_irref : uint16	// First IR ref for this snapshot. */
  slot_count : uint8	// Number of valid slots. */
  topslot : uint8		// Maximum frame extent. */
  entry_count : uint8;	// Number of compressed entries. 
}

struct TracedFunc{
  func : GCRefPtr // Address of function or proto if bit 1 is set in the address is set
  bcindex : uint16
  depth : uint16
}

struct TracedBC{
  pc : int32
  irtop : uint16 // Current max IR instruction when this byte code was executed
}

message exitstubs{
  startid : uint16
  first : ptr
  count : uint16
  spacing : uint16
}

message protobl{
  time : timestamp
  proto : GCRefPtr (argtype : GCproto *)
  bcindex : uint32
}

table luastack{
  vmstate :  uint8
  framesonly : bool
  flags :  uint16
  base :  int32
  top :  int32
  savedpc : MRef
  slots : [TValue]
}

message perf_snapshot{
  time : timestamp
  counters: perf_counters (optional)
  timers : perf_timers (optional)
}

table perf_counters{
  counts : [uint32]
  ids : [uint16]
}

table perf_timers{
  flags : uint8
  timers : [TimerEntry]
  ids : [uint16]
}

struct TimerEntry{
  time : uint64
  count : uint32
  max : uint32
}

message perf_section (no_vtable, enumlist : section) {
  time : timestamp
  jitted : bool
  istrace : bool
  isstart : bool
  id : 21
}

table ReflectInfo{
  typenames : stringlist
  typesizes : [uint32]
  fieldnames : stringlist
  fieldoffsets : [uint32]
}

message obj_raw{
  objtype : uint8
  flags : uint16
  address : GCRefPtr
  objmem : [uint8]
  extra : [uint8]
}

message gcsnapshot{
  time : timestamp
  capture_time : uint64
  label: string (optional)
  registry : GCRefPtr
  globalenv : GCRefPtr
  objs : [SnapObj]
  huge_objs : [HugeSnapObj]
  objmem : [uint8]
  ctypeids : [uint16]
}

struct SnapObj{
  address : GCRef
  typesize : uint32
}

struct HugeSnapObj {
  address : GCRef
  typeinfo : uint32
  index : uint32
  size : uint64
}
