//
// The built-in numeric types are uint8/s8, uint16/s16, uint32/s32, uint64/s64 unsigned and signed respectively.
// Field types that are declared with just a number  are considered unsigned bit fields with a max size of 32 bits.
// Array fields are specified as a element type inside brackets with the name of
// the array's length field in-between them like this int32[elementcount_field].
//
//Special field types
//  ptr: A pointer field that is always stored as a 64 bit value on both 32 bit and 64 bit builds.
//  GCRef: A pointer to a GC object passed in to the log function as a GCRef struct value. This type is
//         32 bits wide on both 32 bit and 64 bit (non GC64) builds it grows to 64 bits for GC64 builds.
//  GCRefPtr: The same as GCRef except the value is passed in as a pointer instead of a GCRef struct
//            in the writer.
//  bool: A boolean stored as a bit field with a bit width of one. It should be turned back into a native
//        boolean value by the reader.
//  timestamp: An implicit 64 bit time stamp generated when the message is written. By default this is
//             the value returned from rdtsc.
//  string: An array field that has extra logic in both the writer and reader side to work as a string.
//          If no length field is specified one is implicitly generated and strlen is used to determine
//          the length on the writer side and the null terminator skipped.
//  stringlist: A list of strings joined together into an array but separated with nulls chars.
//

message header {
  fileheader : 24
  version : uint32
  headersize : uint32
  flags : uint32
  vtables : [uint16]
  vtable_offsets : [uint32]
  msgsizes : [int32]
  typenames : stringlist
  cpumodel : string
  os : string
  ggaddress : uint64
  msgtype_count : uint8
  structtype_count : uint16
  tabletype_count : uint16
  starttime: timestamp
  timerfreq : uint64
  enums : [enumdef]
  vmsettings : VMSettings
  vmdef : VMDef
  gcinfo : gc_info
}

message stringmarker{
  time : timestamp
  jitted : bool
  flags : 16
  label : string
}

message idmarker4b (no_vtable){
  jited : bool
  flags : 7
  id : 16
}

message idmarker (no_vtable, mapto : idmarker4b){
  time : timestamp
  jited : bool
  flags : 7
  id : 16
}

message note{
  time : timestamp
  isbinary : bool
  isinternal : bool
  label : string
  data : [uint8] (argtype : const void*)
}

table enumdef{
  isbitflags : bool
  name : string
  namecount : uint32
  valuenames : stringlist
}

message trace_exit (no_vtable){
  isgcexit : bool
  traceid : uint16
  exit : uint16
}

message trace_exitsmall (no_vtable, mapto : trace_exit) {
  isgcexit : bool
  traceid : 14
  exit : 9
}

message trace_exitfull (mapto : trace_exit) {
  time : timestamp
  isgcexit : bool
  traceid : uint16
  exit : uint16
  registers : register_state (optional)
}

table register_state{
  source : uint8
  gpr_count : uint8
  fpr_count : uint8
  vec_count : uint8
  gprs : [uint8]
  fprs : [uint8]
  vregs : [uint8]
}

message trace_flushall{
  time : timestamp
  reason : uint16 (enum : flushreason)
  tracelimit : uint16
  mcodelimit : uint32
}

table VMSettings{
  jitparams : [int32]
  jitparams_default: [int32]  (optional)
  gc_stepmul : uint32
  gc_pause : uint32
}

table VMDef{
  flushreason : stringlist
  jitparams : stringlist
  gcstates : stringlist
}

message gcstate {
  time : timestamp
  prevstate : uint8
  gcinfo : gc_info 
}

table gc_info{
  totalmem : GCSize
  strnum : uint32
  state : uint8 (enum : gcstate)
}
